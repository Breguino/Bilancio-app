{
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": [".next/", "node_modules/", "public/"],
  "plugins": ["@typescript-eslint"],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ]
  }
}
