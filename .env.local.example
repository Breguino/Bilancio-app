NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Newsletter (facoltativo in locale, richiesto in produzione per l'invio)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-api-key
NEWSLETTER_FROM_EMAIL="Bilancino <onboarding@resend.dev>"
NEWSLETTER_ADMIN_EMAIL=tuo-indirizzo@esempio.com
CRON_SECRET=una-stringa-casuale-lunga

# Google Analytics 4 (facoltativo). In produzione l'identificativo del sito è
# già nel codice (lib/analytics.ts): questa variabile serve solo per usarne un
# altro, e ha la precedenza. In locale, se non la imposti, non parte nessuno
# script e non compare il banner cookie.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
